   "source": [
    "wb = worldbank.load_worldbank()\n",
    "print(f\"{len(wb)} countries; indicators: \"\n",
    "      f\"regulatory quality ({wb['regulatory_quality_code'].iloc[0]}, \"\n",
    "      f\"latest year {wb['regulatory_quality_year'].max():.0f}), \"\n",
    "      f\"GDP per capita (latest year {wb['gdp_per_capita_year'].max():.0f})\")\n",
    "\n",
    "joined = units.loc[units[\"in_outcome_sample\"]].merge(wb, on=\"iso3\", how=\"left\")\n",
    "coverage_wb = joined.groupby(joined[\"regulatory_quality\"].notna())[\"capacity_mw\"].sum()\n",
    "print(f\"Share of outcome-sample capacity matched to World Bank data: \"\n",
    "      f\"{coverage_wb.get(True, 0) / coverage_wb.sum():.1%}\")\n",
    "display(joined.loc[joined[\"regulatory_quality\"].isna(), \"country\"].value_counts().head(10))"
   ]
  },
