   "source": [
    "selection = [\"India\", \"China\", \"United States\", \"United Kingdom\", \"Germany\", \"Australia\",\n",
    "             \"Brazil\", \"Greece\", \"Türkiye\", \"Uzbekistan\", \"Morocco\"]\n",
    "shown = countries.loc[(countries[\"area\"] != \"Rest of world\") | countries[\"country\"].isin(selection)]\n",
    "plot = plots.plot_rates(\n",
    "    shown, \"country\", color=\"area\", reference=WORLD_RATE, height=6,\n",
    "    title=\"Gulf countries build what they announce, but not all of them\",\n",
    "    subtitle=\"Share of capacity abandoned rather than built. Middle East and selected countries\",\n",
    ")\n",
    "plots.save(plot, \"rates_by_country\", 8, 6)\n",
    "plot"
   ]
