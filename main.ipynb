   "source": [
    "model_data = model.model_table(units, ownership, wb)\n",
    "\n",
    "formula_a = ('abandoned ~ C(technology, Treatment(\"Solar\")) + log_capacity'\n",
    "             ' + C(area, Treatment(\"Rest of world\")) + C(sponsor, Treatment(\"Other owner\"))')\n",
    "formula_b = formula_a + (' + C(income_group, Treatment(\"High income\"))'\n",
    "                         ' + regulatory_quality + I(regulatory_quality ** 2)')\n",
    "\n",
    "models = {\n",
    "    \"A, unweighted\": model.fit_logit(model_data, formula_a, weighted=False),\n",
    "    \"A\": model.fit_logit(model_data, formula_a),\n",
    "    \"B\": model.fit_logit(model_data, formula_b),\n",
    "}\n",
    "comparison = model.compare_models(models)\n",
    "display(comparison.style.format(\"{:.2f}\", subset=comparison.columns[1:], na_rep=\"–\")\n",
    "        .hide(axis=\"index\"))\n",
    "display(model.model_summary(models).style.format({\"units\": \"{:,.0f}\", \"pseudo_r2\": \"{:.2f}\"}))\n",
    "\n",
    "b = models[\"B\"].params\n",
    "print(f\"Lowest predicted abandonment at a regulatory quality of \"\n",
    "      f\"{-b['regulatory_quality'] / (2 * b['I(regulatory_quality ** 2)']):.2f}\")"
   ]
  },
