   "source": [
    "middle_east = units.loc[units[\"area\"] != \"Rest of world\"]\n",
    "me_stages = indicators.capacity_by_stage(middle_east, \"technology\")\n",
    "plot = plots.plot_capacity_by_stage(\n",
    "    me_stages,\n",
    "    title=\"The Middle East builds gas and announces renewables\",\n",
    "    subtitle=\"Power capacity in the GCC and the rest of the Middle East, GW, by stage\",\n",
