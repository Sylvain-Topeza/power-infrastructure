   "source": [
    "plot = plots.plot_odds_ratios(\n",
    "    model.readable_labels(model.odds_ratios(models[\"B\"])),\n",
    "    title=\"Odds of abandonment by technology, region and sponsor\",\n",
    "    subtitle=\"Odds ratios (model B, weighted by capacity), 95% confidence intervals\\n\"\n",
    "             \"clustered by country. Reference: solar, high income, rest of world, other owner\",\n",
    ")\n",
    "plots.save(plot, \"odds_ratios\", 8, 5.5)\n",
    "plot"
