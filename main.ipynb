   "source": [
    "status_table = (\n",
    "    units_raw\n",
    "    .groupby(\"status\")\n",
    "    .agg(units=(\"unit_id\", \"count\"), capacity_gw=(\"capacity_mw\", \"sum\"))\n",
    "    .assign(capacity_gw=lambda df: df[\"capacity_gw\"] / 1000,\n",
    "            share_of_capacity=lambda df: df[\"capacity_gw\"] / df[\"capacity_gw\"].sum())\n",
    "    .sort_values(\"capacity_gw\", ascending=False)\n",
    ")\n",
    "display(status_table.style.format(\n",
    "    {\"units\": \"{:,.0f}\", \"capacity_gw\": \"{:,.0f}\", \"share_of_capacity\": \"{:.1%}\"}))"
